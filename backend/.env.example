APP_NAME="Integrated Delivery Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-BACKEND-DOMAIN

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=delivery_portal_cache
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=delivery_portal_session
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@YOUR-DOMAIN
MAIL_FROM_NAME="Integrated Delivery Portal"

SANCTUM_STATEFUL_DOMAINS=YOUR-VERCEL-DOMAIN
CORS_ALLOWED_ORIGINS=https://YOUR-VERCEL-DOMAIN
CORS_SUPPORTS_CREDENTIALS=true

FRONTEND_URL=https://YOUR-VERCEL-DOMAIN
MEDIA_BASE_URL=https://YOUR-BACKEND-DOMAIN
